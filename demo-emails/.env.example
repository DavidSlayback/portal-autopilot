# Copy to demo-emails/.env (git-ignored) and fill in. Never commit the real file.
# App password: Google Account > Security > 2-Step Verification > App passwords.

# The Gmail address registered as Bluebonnet's sender in ~/autopilot/portals.json on the Bot
# computer. Per bot/SETUP.md this is the inbox the Sentry Bot watches.
DEMO_FROM=
DEMO_APP_PASSWORD=

# Leave empty to send to DEMO_FROM itself (the watched inbox).
DEMO_TO=
